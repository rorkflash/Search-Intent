{
  "version": "1.0.0",
  "api": {
    "base_url_from_env": "TARGET_API_BASE_URL",
    "mode": "generate_and_execute"
  },
  "endpoints": {
    "search": {
      "method": "POST",
      "path": "/v1/search",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "q": "{{ search_object.filters.q }}",
        "types": "{{ search_object.objects }}",
        "lang": "{{ search_object.locale }}",
        "limit": "{{ search_object.pagination.limit }}",
        "filters": {
          "country_id": "{{ search_object.filters.country_ids.first }}",
          "city_id": "{{ search_object.filters.city_ids.first }}",
          "genre_id": "{{ search_object.filters.genre_ids.first }}",
          "genres": "{{ search_object.filters.genre_ids }}",
          "place_type": "{{ search_object.filters.place_type_ids.first }}",
          "year_from": "{{ search_object.filters.year_from }}",
          "year_to": "{{ search_object.filters.year_to }}"
        }
      },
      "options": {
        "remove_null_values": true,
        "remove_empty_arrays": true,
        "remove_empty_objects": true
      }
    }
  },
  "intent_endpoint_map": {
    "search_places": "search",
    "search_scenes": "search",
    "search_trips": "search",
    "search_movies": "search",
    "global_search": "search"
  }
}
