  "entities": {
    "movie_title": {
      "label": "movie_title",
      "description": "Movie or TV show title. Do NOT list the full catalog in examples. extract_quoted handles 'Title'/\"Title\"; extract_residual takes leftover text after other entities + search keywords (so unquoted Inferno works). Optional examples only boost a few common titles.",
      "extract_quoted": true,
      "extract_residual": true,
      "residual_cues": [
        "movie", "movies", "film", "films", "show", "shows",
        "scene", "scenes", "shot", "shots", "title"
      ],
      "residual_stopwords": [
        "movie", "movies", "film", "films", "show", "shows",
        "scene", "scenes", "shot", "shots", "filming", "filmed",
        "place", "places", "location", "locations", "spot", "spots",
        "where", "like", "from", "near", "around", "set", "visit",
        "trip", "travel", "vacation", "abroad", "planning", "find",
        "search", "with", "and", "or", "based", "about",
        "need", "all", "started", "start", "starting", "between",
        "since", "until", "after", "before", "year", "years",
        "released", "release", "during", "i", "me", "my", "we",
        "you", "please", "want", "get", "looking", "look"
      ],
      "examples": [
        "Harry Potter",
        "Game of Thrones",
        "Lord of the Rings",
        "James Bond",
        "Star Wars",
        "Inception",
        "The Hobbit",
        "Notting Hill"
      ]
